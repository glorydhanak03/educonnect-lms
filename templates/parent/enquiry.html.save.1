    </svg>
    <span>Enquiry Guidelines</span>
</div>
</div>
<br><br>

<div class="guideline-badge" style="display:flex;align-items:center;gap:8px;">
    <svg width="20" height="20" fill="#2563eb" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"/>
        <text x="12" y="16" text-anchor="middle" font-size="14" fill="white">!</text>
    </svg>
    <span>General Rule</span>
</div>
<ul>
<li>All enquiries must be submitted with accurate and complete information.</li>
<li>Enquiries will be reviewed within 24–48 working hours.</li>
<li>Duplicate enquiries for the same issue should be avoided.</li>
</ul>

<div class="guideline-badge" style="display:flex;align-items:center;gap:8px;">
    <svg width="22" height="22" fill="#16a34a" viewBox="0 0 24 24">
        <path d="M16 11c1.66 0 3-1.34 3-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zM8 13c-2.67 0-8 1.34-8 4v2h10v-2c0-2.66-5.33-4-8-4zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.98 1.97 3.45v2h7v-2c0-2.66-5.33-4-8-4z"/>
    </svg>
    <span>Parent</span>
</div>
<ul>
<li>Clearly mention your child’s full name and class/grade.</li>
<li>Use your registered parent account while submitting enquiries.</li>
<li>Select the correct enquiry category before submission.</li>
<li>For fee-related issues, attach payment proof if applicable.</li>
</ul>

</div>
</div>


<script>

function openDetails(){
    document.getElementById("detailsPopup").style.display="flex";
}

function openFeedback(){
    document.getElementById("feedbackPopup").style.display="flex";
}

function openGuidelines(){
    document.getElementById("guidelinesPopup").style.display="flex";
}

function closePopup(id){
    document.getElementById(id).style.display="none";
}

/* ⭐ Dynamic Star Rating */
function rate(star){
    let stars=document.querySelectorAll("#stars span");
    stars.forEach((s,i)=>{
        if(i<star){
            s.classList.add("active");
        }else{
            s.classList.remove("active");
        }
    });
}

</script>

