{% extends "parent/base_parent.html" %}
{% block parent_title %}Parent | Enquiry{% endblock %}
{% block parent_content %}
<br>

<style>

/* ================= PAGE ================= */
.enquiry-container{
    padding:30px;
}

.enquiry-card{
    background:#ffffff;
    padding:25px;
    border-radius:16px;
    box-shadow:0 8px 20px rgba(0,0,0,0.08);
    margin-bottom:30px;
}

.enquiry-title{
    font-size:26px;
    font-weight:600;
    margin-bottom:20px;
}

/* ================= FORM ================= */
.form-group{
    margin-bottom:14px;
}

.form-group label{
    font-weight:500;
    margin-bottom:5px;
    display:block;
}

.form-control{
    width:100%;
    padding:8px 12px;
    border-radius:8px;
    border:1px solid #dcdcdc;
}

textarea.form-control{
    height:80px;
}

.send-btn{
    background:#3ca55c;
    color:#fff;
    padding:8px 30px;
    border:none;
    border-radius:8px;
    font-weight:500;
}

/* ================= TABLE ================= */
.my-enquiry{
    background:#ffffff;
    padding:20px;
    border-radius:16px;
    box-shadow:0 8px 20px rgba(0,0,0,0.08);
}

.my-enquiry h4{
    font-weight:600;
    margin-bottom:15px;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:10px;
    border:1px solid #e5e5e5;
    text-align:center;
    font-size:14px;
}

.view-btn{
    background:#28a745;
    color:#fff;
    padding:5px 12px;
    border:none;
    border-radius:6px;
}

.feedback-btn{
    background:#e74c3c;
    color:#fff;
    padding:5px 12px;
    border:none;
    border-radius:6px;
}

/* ================= POPUP ================= */
.popup-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.4);
    backdrop-filter:blur(6px);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:999;
}

.popup-box{
    width:750px;
    background:#fff;
    border-radius:16px;
    padding:25px;
    position:relative;
    box-shadow:0 15px 35px rgba(0,0,0,0.2);
}

.popup-title{
    font-size:24px;
    font-weight:600;
    margin-bottom:20px;
}

.close-btn{
    position:absolute;
    right:20px;
    top:20px;
    font-size:22px;
    cursor:pointer;
}

.popup-header{
    background:#FBF9F9;
    padding:18px 25px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid #eee;
    width:107%;
    margin-top:-26px;
    margin-left:-25px;
    border-radius: 16px 16px 0 0;
}

.popup-title{
    font-size:22px;
    font-weight:600;
    display:flex;
    margin-top:20px;
}

/* BODY */
.popup-body{
    padding:25px;
}

.popup-body table tr{
    border-bottom:1px solid #eee;
}


/* ================= STARS ================= */
.star-rating{
    font-size:28px;
    color:#ccc;
    cursor:pointer;
}

.star-rating .active{
    color:gold;
}

.guideline-badge{
    background:#e8f0ff;
    padding:8px 14px;
    border-radius:8px;
    font-weight:600;
    display:inline-block;
    margin:10px 0;
}

/* ================= PAGINATION ================= */

.pagination-container{
    margin-top:20px;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:8px;
}

.page-btn,
.page-number{
    padding:6px 14px;
    border:1px solid #e5e7eb;
    background:#ffffff;
    border-radius:8px;
    cursor:pointer;
    font-size:14px;
    transition:0.2s ease;
}

/* Active page */
.page-number.active{
    background:#2563eb;
    color:#ffffff;
    border:1px solid #2563eb;
}

/* Hover effect */
.page-btn:hover,
.page-number:hover{
    background:#f3f4f6;
}

.page-number.active{
    background:#2563eb;
    color:#fff;
    border:1px solid #2563eb;
    box-shadow:0 4px 10px rgba(37,99,235,0.3);
}


</style>

