<div class="popup-overlay" id="cancelPopup">
<div class="popup-box">

<div class="popup-header">
<div class="popup-title">
<svg width="26" height="26" fill="#6b7280" viewBox="0 0 24 24">
<path d="M18 6 6 18M6 6l12 12"/>
</svg>
<span>Cancel Enquiry</span>
</div>
<span class="close-btn" onclick="closePopup('cancelPopup')">✖</span>
</div>

<div class="popup-body">

<p><strong>Student:</strong> <span id="cancelStudent"></span></p>

<textarea style="width:100%;height:90px;border:1px solid #ddd;border-radius:8px;padding:10px;"
placeholder="Reason for cancellation"></textarea>

<br><br>

<button class="send-btn" style="background:#6b7280;">Confirm Cancel</button>
<button class="feedback-btn" onclick="closePopup('cancelPopup')">Close</button>

</div>
</div>
</div>


<script>

/* ================= POPUP CONTROL ================= */

function openPopup(id){
    document.getElementById(id).classList.add("active");
}

function closePopup(id){
    document.getElementById(id).classList.remove("active");
}

/* ================= STAR RATING ================= */

function rate(star){
    let stars=document.querySelectorAll("#stars span");
    stars.forEach((s,i)=>{
        if(i<star){ s.classList.add("active"); }
        else{ s.classList.remove("active"); }
    });
}

/* ================= HANDLE DROPDOWN ACTION ================= */

let currentRow = null; // store active row

function handleAction(select){

    let value = select.value;
    let row = select.closest("tr");

    currentRow = row; // store row globally

    let studentName = row.children[2].innerText;
    let className = row.children[3].innerText;
    let type = row.children[4].innerText;
    let date = row.children[5].innerText;
    let status = row.children[6].innerText;

    if(value.includes("Reschedule")){

        document.getElementById("resStudentName").innerText = studentName;
        document.getElementById("resCurrentDate").innerText = date;
        document.getElementById("resClass").innerText = className;
        document.getElementById("resTime").innerText = "01:15 PM"; // demo time
        document.getElementById("resType").innerText = type;
        document.getElementById("resStatus").innerText = status;

        openPopup("reschedulePopup");
    }

    else if(value.includes("Approve")){
        document.getElementById("approveStudent").innerText = studentName;
        document.getElementById("approveDate").innerText = date;
        openPopup("approvePopup");
    }

    else if(value.includes("Reject")){
        document.getElementById("rejectStudent").innerText = studentName;
        openPopup("rejectPopup");
    }

    else if(value.includes("Mark as Complete")){
        document.getElementById("completeStudent").innerText = studentName;
        openPopup("completePopup");
    }

    else if(value.includes("Cancel")){
        document.getElementById("cancelStudent").innerText = studentName;
        openPopup("cancelPopup");
    }

    else if(value.includes("View")){
        openPopup("detailsPopup");
    }

    else if(value.includes("Feedback")){
        openPopup("feedbackPopup");
    }

    select.selectedIndex = 0;
}

function confirmReschedule(){

    if(currentRow){

        let statusCell = currentRow.children[6];

        statusCell.innerText = "Rescheduled";
        statusCell.className = "status-pending";

        closePopup("reschedulePopup");
    }
}

let currentPage = 1;
let rowsPerPage = 8;

function showPage(page){

    let table = document.getElementById("enquiryTable");
    let rows = table.querySelectorAll("tr");

    let start = (page - 1) * rowsPerPage + 1;
    let end = start + rowsPerPage - 1;

    rows.forEach((row, index) => {

        if(index === 0){
            row.style.display = ""; // header
        }
        else if(index >= start && index <= end){
            row.style.display = "";
        }
        else{
            row.style.display = "none";
        }

    });

    updateActiveButton(page);
}

function updateActiveButton(page){
    document.querySelectorAll(".page-number").forEach(btn=>{
        btn.classList.remove("active");
    });

    document.querySelectorAll(".page-number")[page-1].classList.add("active");

    currentPage = page;
}

function goToPage(page){
    showPage(page);
}

function nextPage(){
    let totalPages = document.querySelectorAll(".page-number").length;
    if(currentPage < totalPages){
        showPage(currentPage + 1);
    }
}

function prevPage(){
    if(currentPage > 1){
        showPage(currentPage - 1);
    }
}

/* Load first page on start */
document.addEventListener("DOMContentLoaded", function(){
    showPage(1);
});

function switchTab(type){

    let tabs = document.querySelectorAll(".tab-item");
    tabs.forEach(t => t.classList.remove("active"));

    if(type === "student"){
        tabs[0].classList.add("active");
        document.getElementById("studentTable").style.display = "block";
        document.getElementById("parentTable").style.display = "none";
    }
    else{
        tabs[1].classList.add("active");
        document.getElementById("studentTable").style.display = "none";
        document.getElementById("parentTable").style.display = "block";
    }

}

</script>


{% endblock %}

