{% extends "faculty/base_faculty.html" %}

{% block faculty_title %}Faculty | enquiry{% endblock %}

{% block faculty_content %}

<style>

/* PAGE */
.enquiry-container{ padding:30px; }
.enquiry-card{
    background:#fff;
    padding:20px;
    border-radius:16px;
    box-shadow:0 8px 20px rgba(0,0,0,0.08);
}

/* TABLE */
table{ width:100%; border-collapse:collapse; font-size:14px; }
th,td{ border:1px solid #e5e7eb; padding:10px; text-align:center; }
th{ background:#f9fafb; font-weight:600; }

/* STATUS COLORS */
.status-pending{color:#f59e0b;font-weight:600;}
.status-approved{color:#16a34a;font-weight:600;}
.status-complete{color:#2563eb;font-weight:600;}
.status-rejected{color:#dc2626;font-weight:600;}
.status-cancelled{color:#6b7280;font-weight:600;}

/* DROPDOWN */
.action-select{ padding:6px 10px; border-radius:6px; }

/* ================= POPUP OVERLAY ================= */
.popup-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.4);
    backdrop-filter:blur(6px);

    display:flex;                /* Always flex */
    justify-content:center;
    align-items:center;
    z-index:999;

    opacity:0;
    visibility:hidden;
    transition:all 0.3s ease;
}

/* When active */
.popup-overlay.active{
    opacity:1;
    visibility:visible;
}

/* ================= POPUP BOX ================= */
.popup-box{
    width:750px;
    background:#fff;
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 15px 35px rgba(0,0,0,0.2);

    transform:scale(0.9);
    transition:0.3s ease;
}

.popup-overlay.active .popup-box{
    transform:scale(1);
}

/* ================= HEADER ================= */
.popup-header{
    background:#FBF9F9;
    padding:18px 25px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid #eee;
}

.popup-title{
    font-size:22px;
    font-weight:600;
    display:flex;
    align-items:center;
    gap:10px;
}

.close-btn{
    font-size:22px;
    cursor:pointer;
}

/* ================= BODY ================= */
.popup-body{
    padding:25px;
}

.popup-body table{
    width:100%;
    border-collapse:collapse;
}

.popup-body table tr{
    border-bottom:1px solid #eee;
}

.popup-body table td{
    padding:10px;
}

.popup-body table td:first-child{
    font-weight:600;
    width:35%;
    background:#f9fafb;
}

/* ================= BUTTONS ================= */
.send-btn{
    background:#2563eb;
    color:#fff;
    padding:8px 16px;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

.feedback-btn{
    background:#e5e7eb;
    padding:8px 16px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    margin-left:10px;
}

/* ================= STAR RATING ================= */
.star-rating{
    font-size:28px;
    color:#ccc;
    cursor:pointer;
}

.star-rating .active{
    color:gold;
}

/* ================= GUIDELINE BADGE ================= */
.guideline-badge{
    background:#e8f0ff;
    padding:8px 14px;
    border-radius:8px;
    font-weight:600;
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin:10px 0;
}

/* ================= PAGINATION ================= */
.pagination-container{
    margin-top:20px;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:8px;
}

.page-btn,
.page-number{
    padding:6px 14px;
    border:1px solid #e5e7eb;
    background:#ffffff;
    border-radius:8px;
    cursor:pointer;
    font-size:14px;
    transition:0.2s ease;
}

.page-number.active{
    background:#2563eb;
    color:#fff;
    border:1px solid #2563eb;
    box-shadow:0 4px 10px rgba(37,99,235,0.3);
}

.page-btn:hover,
.page-number:hover{
    background:#f3f4f6;
}

/* Animation */
.popup-overlay{
    opacity:0;
    visibility:hidden;
    transition:all 0.3s ease;
}

.popup-overlay.active{
    opacity:1;
    visibility:visible;
}

.popup-box{
    transform:scale(0.9);
    transition:0.3s ease;
}

.popup-overlay.active .popup-box{
    transform:scale(1);
}


/* ================= RESCHEDULE SPECIAL ================= */

.reschedule-box{
    width:900px;
}

.reschedule-header{
    background:#f3f4f6;
}

.reschedule-body{
    background:#ffffff;
    padding:30px;
}

.reschedule-card{
    background:#f9fafb;
    border:1px solid #e5e7eb;
    border-radius:10px;
    padding:25px;
}

.section-title{
    font-size:20px;
    font-weight:600;
    margin-bottom:20px;
}

.details-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px 60px;
    margin-bottom:20px;
}

.details-grid label{
    font-weight:600;
    font-size:14px;
    color:#444;
}

.detail-value{
    border-bottom:1px solid #ddd;
    padding:6px 0;
    margin-top:4px;
}

.new-session-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px 60px;
    margin-bottom:20px;
}

.input-style{
    width:100%;
    padding:10px;
    border:1px solid #d1d5db;
    border-radius:8px;
    margin-top:6px;
}

.textarea-style{
    width:100%;
    height:100px;
    padding:10px;
    border:1px solid #d1d5db;
    border-radius:8px;
    margin-top:6px;
}

.confirm-line{
    display:flex;
    align-items:center;
    gap:10px;
    margin-top:10px;
}

.note-text{
    font-size:14px;
    color:#555;
    margin-top:8px;
}

.reschedule-footer{
    display:flex;
    justify-content:center;
    gap:40px;
    margin-top:30px;
}

.confirm-btn{
    background:#f59e0b;
    color:#fff;
    padding:12px 40px;
    border:none;
    border-radius:8px;
    font-size:16px;
    cursor:pointer;
}

.cancel-btn{
    background:#ef4444;
    color:#fff;
    padding:12px 60px;
    border:none;
    border-radius:8px;
    font-size:16px;
    cursor:pointer;
}


</style>


