{% extends "admin_panel/base_admin.html" %}

{% block admin_title %}Admin | Announcement{% endblock %}

{% block admin_content %}

<script>
function openModal(){
    document.getElementById("announcementModal").style.display="flex";
}

function closeModal(){
    document.getElementById("announcementModal").style.display="none";
}
</script>

<style>
.page-wrapper{
    background:#e9f0f8;
    padding:25px;
    border-radius:10px;
}

.page-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.page-header h2{
    font-size:24px;
    font-weight:600;
}

.controls{
    display:flex;
    gap:10px;
}

.controls input,
.controls select{
    padding:8px 12px;
    border-radius:6px;
    border:1px solid #ccc;
    font-size:14px;
}

.send-btn{
    background:#6c63ff;
    color:#fff;
    padding:8px 14px;
    border-radius:6px;
    text-decoration:none;
    font-size:14px;
}

.section-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.category-box{
    background:#fff;
    border-radius:12px;
    padding:20px;
    position:relative;
    box-shadow:0 3px 8px rgba(0,0,0,0.08);
}

.category-box::before{
    content:"";
    position:absolute;
    left:0;
    top:0;
    bottom:0;
    width:6px;
    background:#ff4d4d;
    border-top-left-radius:12px;
    border-bottom-left-radius:12px;
}

.category-title{
    font-size:18px;
    font-weight:600;
    margin-bottom:15px;
}

.announcement-item{
    background:#fde2e2;
    padding:12px;
    border-radius:8px;
    margin-bottom:10px;
}

.announcement-item h5{
    margin:0;
    font-size:15px;
    font-weight:600;
}

.announcement-item p{
    margin:4px 0;
    font-size:13px;
}

.meta{
    font-size:12px;
    color:#555;
}

.open-modal-btn{
    background:#007bff;
    color:white;
    padding:8px 14px;
    border:none;
    border-radius:6px;
    cursor:pointer;
}

/* Overlay */
.modal-overlay{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.4);
    backdrop-filter: blur(6px);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:9999;
}

/* Popup Box */
.modal-box{
    background:#fff;
    width:450px;
    padding:25px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,0.2);
    animation:popIn 0.3s ease-in-out;
}

.modal-box h2{
    margin-bottom:15px;
}

.modal-box input,
.modal-box select,
.modal-box textarea{
    width:100%;
    padding:10px;
    margin-bottom:12px;
    border-radius:8px;
    border:1px solid #ccc;
}

.modal-box textarea{
    height:100px;
    resize:none;
}

.modal-buttons{
    display:flex;
    gap:10px;
}

.submit-btn{
    background:blue;
    color:white;
    padding:8px 16px;
    border:none;
    border-radius:6px;
}

.cancel-btn{
    background:red;
    color:white;
    padding:8px 16px;
    border:none;
    border-radius:6px;
}

@keyframes popIn{
    from{
        transform:scale(0.8);
        opacity:0;
    }
    to{
        transform:scale(1);
        opacity:1;
    }
}

</style>

<div class="page-wrapper">

    <div class="page-header">
        <h2>🔔 Announcement & Notifications</h2>
        <div class="controls">
            <input type="text" placeholder="Search...">
            <select>
                <option>All Categories</option>
                <option>Students</option>
                <option>Faculty</option>
                <option>Parents</option>
                <option>Exams</option>
                <option>Payments</option>
                <option>Results</option>
            </select>
            <a href="{% url 'admin_panel:admin_announcement' %}" class="send-btn">
                <button class="open-modal-btn" onclick="openModal()">
                       Send Announcement & Notifications
                </button>

            </a>
        </div>
    </div>

    <div class="section-grid">

        <!-- Students -->
        <div class="category-box">
            <div class="category-title">Students</div>
            {% for announcement in announcements %}
                {% if announcement.audience == "student" or announcement.audience == "all" %}
                <div class="announcement-item">
                    <h5>{{ announcement.title }}</h5>
                    <p>{{ announcement.message|truncatechars:80 }}</p>
                    <div class="meta">
                        By: {{ announcement.created_by }} | {{ announcement.created_at }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <!-- Faculty -->
        <div class="category-box">
            <div class="category-title">Faculty</div>
            {% for announcement in announcements %}
                {% if announcement.audience == "faculty" or announcement.audience == "all" %}
                <div class="announcement-item">
                    <h5>{{ announcement.title }}</h5>
                    <p>{{ announcement.message|truncatechars:80 }}</p>
                    <div class="meta">
                        By: {{ announcement.created_by }} | {{ announcement.created_at }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <!-- Parents -->
        <div class="category-box">
            <div class="category-title">Parents</div>
            {% for announcement in announcements %}
                {% if announcement.audience == "parent" or announcement.audience == "all" %}
                <div class="announcement-item">
                    <h5>{{ announcement.title }}</h5>
                    <p>{{ announcement.message|truncatechars:80 }}</p>
                    <div class="meta">
                        By: {{ announcement.created_by }} | {{ announcement.created_at }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <!-- Exams -->
        <div class="category-box">
            <div class="category-title">Exams</div>
            {% for announcement in announcements %}
                {% if announcement.audience == "exam" %}
                <div class="announcement-item">
                    <h5>{{ announcement.title }}</h5>
                    <p>{{ announcement.message|truncatechars:80 }}</p>
                    <div class="meta">
                        By: {{ announcement.created_by }} | {{ announcement.created_at }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <!-- Payments -->
        <div class="category-box">
            <div class="category-title">Payments</div>
            {% for announcement in announcements %}
                {% if announcement.audience == "payment" %}
                <div class="announcement-item">
                    <h5>{{ announcement.title }}</h5>
                    <p>{{ announcement.message|truncatechars:80 }}</p>
                    <div class="meta">
                        By: {{ announcement.created_by }} | {{ announcement.created_at }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <!-- Results -->
        <div class="category-box">
            <div class="category-title">Results</div>
            {% for announcement in announcements %}
                {% if announcement.audience == "result" %}
                <div class="announcement-item">
                    <h5>{{ announcement.title }}</h5>
                    <p>{{ announcement.message|truncatechars:80 }}</p>
                    <div class="meta">
                        By: {{ announcement.created_by }} | {{ announcement.created_at }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

    </div>

</div>

{% endblock %}
<!-- Background Overlay -->
<div id="announcementModal" class="modal-overlay">
    
    <div class="modal-box">
        <h2>Add Announcement</h2>

        <form method="POST" action="{% url 'add_announcement' %}">
            {% csrf_token %}

            <input type="text" name="title" placeholder="Enter Title" required>

            <input type="text" value="Admin" disabled>

            <label>Select Category (choose one or more)</label>
            <select name="audience" multiple required>
                <option value="students">Students</option>
                <option value="faculty">Faculty</option>
                <option value="parents">Parents</option>
                <option value="exams">Exams</option>
                <option value="payments">Payments</option>
                <option value="results">Results</option>
            </select>

            <textarea name="message" placeholder="Enter description..." required></textarea>

            <div class="modal-buttons">
                <button type="submit" class="submit-btn">Submit</button>
                <button type="button" class="cancel-btn" onclick="closeModal()">Cancel</button>
            </div>
        </form>
    </div>

</div>
